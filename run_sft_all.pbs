#!/bin/bash
#PBS -N sft_all_scales
#PBS -l select=1:ngpus=2:mem=128gb
#PBS -l walltime=10:00:00
#PBS -j oe
#PBS -o /scratch/users/nus/e1553316/assignment5/outputs/sft/pbs_sft_all.log

# SFT 多规模实验（N=256 / 512 / 1024 / full）顺序执行
# 提交方式：qsub run_sft_all.pbs
# N=128 已单独跑完，本脚本从 N=256 起继续。

set -euo pipefail

PROJECT=/scratch/users/nus/e1553316/assignment5
cd "$PROJECT"
source .venv/bin/activate

export ASSIGNMENT5_MODEL_ID="$PROJECT/models/Qwen2.5-Math-1.5B"
export HF_HOME=/scratch/users/nus/e1553316/.cache/huggingface
export VLLM_LOGGING_LEVEL=WARNING
export WANDB_MODE=offline

_run_sft() {
    local N=$1
    local RUN_NAME
    if [ "$N" -eq 0 ]; then
        RUN_NAME="run_full"
    else
        RUN_NAME="run_n${N}"
    fi

    echo "========================================"
    echo "[PBS] Starting SFT: N=${N}  run=${RUN_NAME}  $(date)"
    echo "========================================"

    uv run python -m cs336_alignment.sft \
        --model-path   "$ASSIGNMENT5_MODEL_ID" \
        --train-path   data/math/train.jsonl \
        --log-directory "outputs/sft/${RUN_NAME}" \
        --max-train-examples "${N}" \
        --seed             42 \
        --epochs           3 \
        --micro-batch-size 1 \
        --local-batch-size 32 \
        --lr               1e-5 \
        --log-every-local-steps      10 \
        --eval-every-local-steps     0 \
        --run-baseline-eval-at-step0 \
        --run-final-eval \
        --vllm-device               cuda:1 \
        --vllm-gpu-memory-utilization 0.85 \
        --save-final-checkpoint \
        --save-every-local-steps 0 \
        --use-wandb \
        --wandb-project cs336-a5-sft \
        --wandb-run-name "${RUN_NAME}"

    echo "[PBS] Finished SFT: N=${N}  $(date)"
}

mkdir -p outputs/sft

_run_sft 256
_run_sft 512
_run_sft 1024
_run_sft 0

echo "========================================"
echo "[PBS] All SFT runs completed.  $(date)"
echo "========================================"
