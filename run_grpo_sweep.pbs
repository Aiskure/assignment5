#!/bin/bash
#PBS -N grpo_sweep
#PBS -l select=1:ngpus=2:mem=128gb
#PBS -l walltime=08:00:00
#PBS -j oe

PROJECT=/scratch/users/nus/e1553316/assignment5

# 通过 qsub -v 传入：RUN_NAME 和 LR
# 示例：qsub -v RUN_NAME=run2_lr3e6,LR=3e-6 run_grpo_sweep.pbs
RUN_NAME="${RUN_NAME:-sweep_run}"
LR="${LR:-1e-5}"
LOSS_TYPE="${LOSS_TYPE:-reinforce_with_baseline}"
LOSS_AGGREGATION="${LOSS_AGGREGATION:-masked_normalize}"
USE_STD="${USE_STD:-false}"
EPOCHS="${EPOCHS:-1}"
TRAIN_BS="${TRAIN_BS:-256}"
GRAD_ACC="${GRAD_ACC:-128}"

LOG_DIR="$PROJECT/outputs/grpo/$RUN_NAME"
mkdir -p "$LOG_DIR"

# 重定向 stdout/stderr 到带 RUN_NAME 的日志文件（#PBS -o 不支持变量展开）
exec > "$LOG_DIR/pbs_job.log" 2>&1

export ASSIGNMENT5_MODEL_ID="$PROJECT/models/Qwen2.5-Math-1.5B"
export HF_HOME=/scratch/users/nus/e1553316/.cache/huggingface
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export VLLM_LOGGING_LEVEL=WARNING
export WANDB_MODE=offline

cd "$PROJECT"
source .venv/bin/activate

echo "[INFO] RUN_NAME=$RUN_NAME  LR=$LR  LOSS_TYPE=$LOSS_TYPE  LOSS_AGGREGATION=$LOSS_AGGREGATION  USE_STD=$USE_STD  EPOCHS=$EPOCHS  TRAIN_BS=$TRAIN_BS  GRAD_ACC=$GRAD_ACC"

PATH_ARGS=(
    --train-path       data/math/train.jsonl
    --validation-path  data/math/validation.jsonl
    --model-path       "$PROJECT/models/Qwen2.5-Math-1.5B"
    --output-dir       "outputs/grpo/$RUN_NAME"
)

# train_batch_size=256, gradient_accumulation_steps=128
# → micro_train_batch_size = 256 // 128 = 2
# epochs_per_rollout_batch=1，on-policy 模式
TRAIN_ARGS=(
    --seed                        42
    --n-grpo-steps                256
    --rollout-batch-size          256
    --group-size                  8
    --gradient-accumulation-steps "$GRAD_ACC"
    --train-batch-size            "$TRAIN_BS"
    --epochs-per-rollout-batch    "$EPOCHS"
    --loss-type                   "$LOSS_TYPE"
    --loss-aggregation            "$LOSS_AGGREGATION"
    --lr                          "$LR"
    --advantage-eps               1e-6
    $( [ "$USE_STD" = "true" ] && echo "--use-std-normalization" || echo "--no-use-std-normalization" )
)

ROLLOUT_ARGS=(
    --vllm-device              cuda:1
    --gpu-memory-utilization   0.85
    --rollout-temperature      1.0
    --rollout-top-p            1.0
    --sampling-min-tokens      4
    --sampling-max-tokens      1024
)

EVAL_ARGS=(
    --eval-every-steps   10
    --max-eval-samples   1024
    --eval-temperature   1.0
    --eval-top-p         1.0
    --eval-max-tokens    1024
)

WANDB_ARGS=(
    --wandb-project  cs336-a5
    --wandb-group    grpo
    --wandb-run-name "$RUN_NAME"
)

uv run python -m cs336_alignment.grpo_train_loop \
    "${PATH_ARGS[@]}" \
    "${TRAIN_ARGS[@]}" \
    "${ROLLOUT_ARGS[@]}" \
    "${EVAL_ARGS[@]}" \
    "${WANDB_ARGS[@]}"
